{
  "name": "@os-eco/trellis-cli",
  "version": "0.3.0",
  "description": "Offline TypeScript structural audit with a native 0–100 sloppiness index and optional unscored provider evidence",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jayminwest/trellis.git"
  },
  "homepage": "https://github.com/jayminwest/trellis",
  "bugs": {
    "url": "https://github.com/jayminwest/trellis/issues"
  },
  "keywords": [
    "audit",
    "static-analysis",
    "typescript",
    "complexity",
    "duplication",
    "import-cycles",
    "code-quality",
    "cli",
    "developer-tools"
  ],
  "bin": {
    "trellis": "./src/cli/main.ts"
  },
  "scripts": {
    "show-manifest": "bun --eval \"console.log(await Bun.file('nix/package-manifest.json').text())\"",
    "sync:source": "bun run sync:github-release",
    "sync:github-source": "bun run scripts/sync-from-github-source.ts",
    "sync:github-release": "bun run scripts/sync-from-github-release.ts",
    "sync:npm": "bun run sync:npm-source",
    "sync:npm-source": "bun run scripts/sync-from-npm.ts",
    "postinstall": "bun x bun2nix -o bun.nix"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "js-yaml": "^4.1.1",
    "typescript": "6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "bun2nix": "2.0.8"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
